{
  "name": "lil-pstack",
  "private": true,
  "type": "module",
  "description": "Bun-native Cursor SDK coding agent with built-in pstack",
  "packageManager": "bun@1.4.4",
  "bin": {
    "lil-pstack": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "bun check",
    "fmt": "bun fmt --ignore-pattern 'vendor/**' src tests scripts *.md *.json bunfig.toml",
    "fmt:check": "bun fmt --check --ignore-pattern 'vendor/**' src tests scripts *.md *.json bunfig.toml",
    "sync:pstack": "bun run scripts/sync-pstack.ts",
    "parity:pstack": "bun run scripts/parity-pstack.ts",
    "parity:pstack:live": "bun run scripts/live-always-on.ts",
    "parity:pstack:live-route": "bun run scripts/live-playbook-route.ts",
    "test": "bun test tests",
    "build": "bun build ./src/index.ts --target=bun --outdir=dist --packages=external",
    "compile": "bun build --compile ./src/index.ts --outfile dist/lil-pstack --packages=external"
  },
  "files": [
    "src/",
    "vendor/pstack/",
    "vendor/pstack-host/",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@cursor/sdk": "^1.3.1",
    "@opentui/core": "^0.8.3",
    "@opentui/react": "^0.8.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "typescript": "^7"
  }
}
