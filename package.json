{
  "name": "lil-pstack",
  "private": true,
  "type": "module",
  "description": "Bun-native Cursor SDK coding agent with built-in pstack",
  "packageManager": "bun@1.4.4",
  "bin": {
    "lil-pstack": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "build": "bun build ./src/cli.ts --target=bun --outdir=dist",
    "compile": "bun build --compile ./src/cli.ts --outfile dist/lil-pstack"
  },
  "files": [
    "src/",
    "vendor/pstack/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@cursor/sdk": "^1.3.1",
    "@opentui/core": "^0.8.3",
    "@opentui/react": "^0.8.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "typescript": "^7"
  }
}
